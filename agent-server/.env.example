# Optional. Without a key, the agent uses the rule-based decider, which isn't AI
OPENAI_API_KEY=
OPENAI_MODEL=
# Any service with OpenAI's API. Agents' instructions, profiles and page text are sent there on every step.
openai_base=
# auto, openai or rule
AGENT_DECIDER=

# Defaults: the deployed backend, Arc, and a Circle wallet for each agent.
RUPEERAIL_API_URL=
AGENT_CHAIN=
# circle or local
AGENT_SIGNER=
# Testnet only, for AGENT_SIGNER=local.
LOCAL_SIGNER_KEY=

# Where agents are kept. Holds their profiles, so it's created private. Defaults to data/agents.sqlite
AGENT_DB=
# No agent can go above these, whatever it's set to. Defaults: Rs 1000 per order, and 10 USDC of on-chain budget.
AGENT_GLOBAL_MAX_INR=
AGENT_MAX_BUDGET_USDC=

# Where the agent reads the payer's result. Defaults to apps/upi-payer/data/payer.sqlite
PAYER_LEDGER=
# Receives the final result. Never includes an agent's instructions or profile.
AGENT_WEBHOOK_URL=
# When set, only this extension may connect. Otherwise any extension can.
AGENT_EXTENSION_ID=

# Development only. 1 lets a local tool queue rehearsals through /dev, which can't order or pay.
AGENT_DEV_LOOP=
# Development only. Saves each step's page text and screenshot here, so it can hold personal details.
AGENT_DEBUG_DIR=
