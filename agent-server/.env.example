# Optional. Without a key, the agent uses the rule-based decider, which isn't AI.
OPENAI_API_KEY=
OPENAI_MODEL=
# auto, openai or rule
AGENT_DECIDER=

# Defaults: the deployed backend, Arc, and the Circle wallet.
RUPEERAIL_API_URL=
AGENT_CHAIN=
# circle or local
AGENT_SIGNER=
CIRCLE_WALLET=
# Testnet only, for AGENT_SIGNER=local.
LOCAL_SIGNER_KEY=

# Limits. Defaults: Rs 30 per session, and only the local mock store.
AGENT_GLOBAL_MAX_INR=
AGENT_ALLOWED_DOMAINS=

# Where the agent reads the payer's result. Defaults to apps/upi-payer/data/payer.sqlite.
PAYER_LEDGER=
# Receives the final result.
AGENT_WEBHOOK_URL=
# When set, only this extension may connect. Otherwise any extension can.
AGENT_EXTENSION_ID=
