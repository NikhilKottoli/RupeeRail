rupee-rail.indiasouthcentral.cloudapp.azure.com {
	# Every API path. Anything else is the web app. Keep this in step with API_PATHS in vite.config.ts.
	@api path /health /config /account/* /quote /offramp /offramp/* /offramps /dispute /events /events/* /onramp /onramp/* /admin/*
	handle @api {
		reverse_proxy 127.0.0.1:8788
	}

	handle {
		root * /var/www/rupeerail
		encode zstd gzip

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(self), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		}

		# Fingerprinted files never change. Everything that points at them must be checked each time.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"

		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json

		try_files {path} /index.html
		file_server
	}
}
