{
  "manifest_version": 3,
  "name": "RupeeRail Agents",
  "version": "0.1.0",
  "description": "Your own long-lived agents. Each one browses for you and pays a UPI QR from its own wallet, within its limits.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "RupeeRail Agents" }
}
