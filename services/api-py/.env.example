# RupeeRail API (services/api-py). Names only: never commit values.
# Keys: if unset, every role falls back to SEED_PHRASE at m/44'/60'/0'/0/0, read as text from the
# repo-root .env (or the file named by RUPEERAIL_ENV_FILE). Only public addresses are ever logged.
SEED_PHRASE=
QUOTE_SIGNER_PRIVATE_KEY=
PAYMASTER_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
# User key for scripts/e2e_client.py only (never used by the server)
OTHER_WALLET_PRIVATE_KEY=
RUPEERAIL_ENV_FILE=

# Server
PORT=
HOST=
DB_PATH=
CHAINS=
WORKERS=
FX=
DRY_RUN=
LOG_LEVEL=
ADMIN_TOKEN=
EXPOSE_PAYEE_BY_ID=
RATE_LIMIT_PER_MIN=

# Chains (defaults come from deployments/*.json)
ARC_RPC_URL=
WHITECHAIN_RPC_URL=
ARC_START_BLOCK=
WHITECHAIN_START_BLOCK=
ARC_MIN_MAX_FEE_GWEI=
WHITECHAIN_MIN_MAX_FEE_GWEI=

# Pricing and limits
SPREAD_BPS=
QUOTE_TTL_SEC=
MIN_INR_PAISE=
MAX_INR_PAISE=
DAILY_USER_INR_PAISE=
FX_POLL_SEC=
FX_MAX_AGE_SEC=
GLOBAL_REF_POLL_SEC=

# Workers
LISTENER_POLL_SEC=
LISTENER_MAX_RANGE=
LISTENER_CONFIRMATIONS=
SETTLER_TICK_SEC=
KEEPER_TICK_SEC=
PAYOUT_COMMAND=
PAYOUT_TIMEOUT_SEC=
PAYOUT_MAX_LOCK_AGE_SEC=
COMPLETE_ALERT_SEC=
TX_RECEIPT_TIMEOUT_SEC=
COLLECT_UPI_ID=
