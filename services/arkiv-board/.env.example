# Testnet only (Arkiv Rabdi). Copy to .env, which git ignores. Never commit or paste these.

# Free at https://hub.arkiv.network/access-keys. All the reader and npm run verify need.
ARKIV_ACCESS_KEY=

# The publisher only. Its address must match PUBLISHER in src/schema.ts.
BOARD_PUBLISHER_PRIVATE_KEY=
# Any long random value. Set the same one as ARKIV_PUBLISHER_TOKEN in agent-server/.env.
PUBLISHER_TOKEN=
